{
  "Rows": [
    {"ID":1001,"Name_CN":"叶修之死","Type":1,"PrereqFlag":"","Text_CN":"你击败了散修叶修，从他身上找到一颗风灵珠。他奄奄一息地望着你，眼神中既无怨恨，也无哀求——只是静静地等待着自己的命运。你该如何处置他？","Options":[{"Text":"取走风灵珠，吸收他残余的灵力","FlagName":"betrayed_yeXiu","FlagValue":1,"RewardID":2001,"CostID":0,"KarmaChange":1,"DaoxinChange":-5,"LifespanChange":0},{"Text":"将他就地埋葬，立一块无字碑","FlagName":"saved_yeXiu","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":-1,"DaoxinChange":10,"LifespanChange":0},{"Text":"搜刮后扬长而去","FlagName":"ignored_yeXiu","FlagValue":1,"RewardID":2001,"CostID":0,"KarmaChange":0,"DaoxinChange":-2,"LifespanChange":0}]},
    {"ID":1002,"Name_CN":"灵药宝库","Type":3,"PrereqFlag":"saved_yeXiu=1","Text_CN":"一位白发老者悄然现身，目光柔和：「我便是叶修的师父。多谢你善待我那不成器的弟子……这是他生前为我寻得的灵药，便由你带去吧。」","Options":[{"Text":"拜谢前辈赐药","FlagName":"elder_gift","FlagValue":1,"RewardID":3001,"CostID":0,"KarmaChange":0,"DaoxinChange":5,"LifespanChange":0}]},
    {"ID":1003,"Name_CN":"古修遗宝","Type":1,"PrereqFlag":"","Text_CN":"一座古旧石台上躺着一颗散发金光的灵物——天品级的「九转还魂丹」。但你能感觉到，台子周围弥漫着一股诡异的气息，仿佛在汲取着接近者的什么……","Options":[{"Text":"以寿元换取（消耗 10 年寿元）","FlagName":"took_ancient_treasure","FlagValue":1,"RewardID":3001,"CostID":0,"KarmaChange":0,"DaoxinChange":0,"LifespanChange":-10},{"Text":"放弃，转身离去","FlagName":"","FlagValue":0,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":3,"LifespanChange":0},{"Text":"强行夺取（与守护者一战）","FlagName":"forced_treasure","FlagValue":1,"RewardID":3001,"CostID":0,"KarmaChange":2,"DaoxinChange":-5,"LifespanChange":0}]},
    {"ID":2001,"Name_CN":"幽魂哀歌","Type":1,"PrereqFlag":"","Text_CN":"一道虚幻的身影挡住去路。它并不攻击你，只是反复喃喃着一个名字——然后你听清了：那是你的名字。它伸出手，指向身后的石碑，碑上刻满了密密麻麻的文字。","Options":[{"Text":"阅读石碑上的文字","FlagName":"read_ghost_tablet","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":5,"LifespanChange":0},{"Text":"挥剑驱散幽魂","FlagName":"dispelled_ghost","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":1,"DaoxinChange":-3,"LifespanChange":0},{"Text":"转身绕路","FlagName":"avoided_ghost","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":0,"LifespanChange":0}]},
    {"ID":2002,"Name_CN":"冥河渡口","Type":1,"PrereqFlag":"","Text_CN":"幽暗的河水在脚下流淌，一叶扁舟停靠在岸边。一位蒙面艄公站在舟上：「渡河者需付代价。血为筹码，命为舟资——你选哪一样？」","Options":[{"Text":"以血为筹——献祭 30% 当前生命值","FlagName":"blood_toll","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":-2,"LifespanChange":-5},{"Text":"以命为资——消耗 15 年寿元","FlagName":"life_toll","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":0,"LifespanChange":-15},{"Text":"强行渡河（触发战斗）","FlagName":"forced_crossing","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":2,"DaoxinChange":-5,"LifespanChange":0}]},
    {"ID":2003,"Name_CN":"亡者遗言","Type":3,"PrereqFlag":"read_ghost_tablet=1","Text_CN":"石碑上的文字渐渐浮现——那是一位前辈修士的遗言。他在此地困了千年，留下了一套残缺的功法图谱。最后一行写着：「若有缘人至此，愿将毕生所悟相赠。但切记——万事皆有代价。」","Options":[{"Text":"接受功法传承（获得临时增益）","FlagName":"accepted_legacy","FlagValue":1,"RewardID":4001,"CostID":0,"KarmaChange":0,"DaoxinChange":3,"LifespanChange":0},{"Text":"拒绝传承（获得道心加成）","FlagName":"refused_legacy","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":-1,"DaoxinChange":15,"LifespanChange":0}]},
    {"ID":2004,"Name_CN":"灵魂交易","Type":1,"PrereqFlag":"","Text_CN":"一团飘忽不定的光芒凝聚成人形。它的声音沙哑而诱惑：「我能让你变得更强——只需要你一小部分……灵魂。交易结束后，你会觉得少了什么，但又说不上来。」","Options":[{"Text":"接受交易（攻击力+20%，道心-10）","FlagName":"soul_trade","FlagValue":1,"RewardID":5001,"CostID":0,"KarmaChange":0,"DaoxinChange":-10,"LifespanChange":0},{"Text":"拒绝交易","FlagName":"refused_soul_trade","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":5,"LifespanChange":0},{"Text":"反噬术——试图从它身上夺取力量","FlagName":"soul_counter","FlagValue":1,"RewardID":5001,"CostID":0,"KarmaChange":1,"DaoxinChange":-8,"LifespanChange":0}]},
    {"ID":3001,"Name_CN":"龙骨祭坛","Type":1,"PrereqFlag":"","Text_CN":"一座由巨龙骨骸堆砌的祭坛屹立在炼狱峰中心。祭坛上方盘旋着灼热的灵力漩涡，似乎可以用来淬炼自身——但代价是将一部分自我燃烧殆尽。","Options":[{"Text":"以肉身为薪——献祭 40% 生命值换取永久攻击提升","FlagName":"dragon_sacrifice","FlagValue":1,"RewardID":6001,"CostID":0,"KarmaChange":0,"DaoxinChange":-5,"LifespanChange":-10},{"Text":"以心火为引——消耗 20 道心换取临时全属性增益","FlagName":"heart_fire","FlagValue":1,"RewardID":6002,"CostID":0,"KarmaChange":0,"DaoxinChange":-20,"LifespanChange":0},{"Text":"默然离去","FlagName":"left_altar","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":2,"LifespanChange":0}]},
    {"ID":3002,"Name_CN":"天火试炼","Type":1,"PrereqFlag":"","Text_CN":"一道天火从虚空中劈下，将去路阻断。火焰中隐约可见一个符文——破解它或许能让天火为你所用，但失败的代价是遍体鳞伤。","Options":[{"Text":"尝试破解符文（考验运气：60%成功）","FlagName":"fire_trial","FlagValue":1,"RewardID":6003,"CostID":0,"KarmaChange":0,"DaoxinChange":0,"LifespanChange":0},{"Text":"以寿元强行压制天火（消耗 20 年）","FlagName":"suppress_fire","FlagValue":1,"RewardID":6003,"CostID":0,"KarmaChange":0,"DaoxinChange":0,"LifespanChange":-20},{"Text":"绕远路避开","FlagName":"bypass_fire","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":0,"LifespanChange":0}]},
    {"ID":3003,"Name_CN":"龙血觉醒","Type":3,"PrereqFlag":"dragon_sacrifice=1","Text_CN":"祭坛的龙血在你体内翻涌——你感觉自己的血脉正在发生变化。一个低沉的龙吟回荡在脑海中：「汝以血肉为祭，龙骨铸心。自此——汝便是半龙之身。」","Options":[{"Text":"接受龙血觉醒（永久攻防各+15%）","FlagName":"dragon_awakened","FlagValue":1,"RewardID":7001,"CostID":0,"KarmaChange":0,"DaoxinChange":0,"LifespanChange":0},{"Text":"压制龙血——维持人身（道心+15）","FlagName":"suppressed_dragon","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":15,"LifespanChange":0}]},
    {"ID":3004,"Name_CN":"劫雷降世","Type":1,"PrereqFlag":"","Text_CN":"天穹中聚起一团漆黑的雷云——这是修仙者突破时必须面对的天劫。雷云中的威压让你几乎无法呼吸。你可以选择硬抗渡劫，或者借助周围的地形分散雷力。","Options":[{"Text":"硬抗天劫（高风险高收益）","FlagName":"endure_tribulation","FlagValue":1,"RewardID":7002,"CostID":0,"KarmaChange":0,"DaoxinChange":5,"LifespanChange":-15},{"Text":"借地形分散雷力（稳妥方案）","FlagName":"redirect_tribulation","FlagValue":1,"RewardID":7003,"CostID":0,"KarmaChange":0,"DaoxinChange":2,"LifespanChange":0},{"Text":"逃离劫云范围（保命优先）","FlagName":"flee_tribulation","FlagValue":1,"RewardID":0,"CostID":0,"KarmaChange":0,"DaoxinChange":-5,"LifespanChange":0}]}
  ]
