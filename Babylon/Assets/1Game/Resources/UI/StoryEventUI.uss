/* 奇遇事件 · UITK (v0.6) */

.se-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.se-panel {
    width: 820px;
    max-width: 94%;
    max-height: 88%;
    padding-top: 22px;
    padding-bottom: 20px;
    padding-left: 36px;
    padding-right: 36px;
    background-color: rgba(20, 16, 13, 0.97);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-width: 1px;
    border-color: rgba(200, 150, 70, 0.45);
}

.se-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 216, 115);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.se-bodyscroll {
    max-height: 220px;
    margin-bottom: 16px;
}

.se-body {
    font-size: 16px;
    color: rgba(235, 224, 210, 0.95);
    white-space: normal;
}

.se-options {
}

.se-opt {
    min-height: 54px;
    margin-bottom: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-left;
    border-width: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(255, 255, 255, 0.07);
    color: rgb(236, 234, 228);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.se-opt:hover {
    background-color: rgba(210, 160, 80, 0.22);
    scale: 1.01 1.01;
}
