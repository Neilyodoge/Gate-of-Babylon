<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="RoomChoiceUI.uss" />
    <ui:VisualElement name="overlay" class="rc-overlay">
        <ui:VisualElement name="center" class="rc-center">
            <ui:Label text="· 下一步去哪？ ·" class="rc-title" />
            <ui:Label text="点击卡片或按数字键 1 / 2 / 3 选择路径（选择不可撤销）" class="rc-sub" />
            <ui:VisualElement name="cards" class="rc-cards" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
