/* 选化身页 · UITK 试点样式 (v0.6) ——全屏覆盖层，玻璃拟态卡片 */

.overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.74);
}

.panel {
    width: 1180px;
    max-width: 94%;
    padding-top: 28px;
    padding-bottom: 22px;
    padding-left: 30px;
    padding-right: 30px;
    background-color: rgba(18, 18, 24, 0.96);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    align-items: center;
}

.title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(245, 238, 222);
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}

.subtitle {
    font-size: 15px;
    color: rgba(220, 220, 225, 0.62);
    margin-top: 6px;
    margin-bottom: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.cards {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.card {
    width: 212px;
    margin-left: 9px;
    margin-right: 9px;
    padding-bottom: 14px;
    background-color: rgba(32, 32, 40, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    overflow: hidden;
    transition-property: translate, border-color, background-color;
    transition-duration: 0.12s;
}

.card:hover {
    translate: 0 -8px;
    border-color: rgba(255, 255, 255, 0.30);
    background-color: rgba(42, 42, 52, 0.98);
}

.card--default {
    border-color: rgba(255, 216, 64, 0.70);
}

.card__accent {
    height: 6px;
    background-color: rgb(120, 120, 120);
}

.card__badge {
    position: absolute;
    top: 12px;
    right: 10px;
    display: none;
    background-color: rgba(255, 216, 64, 0.16);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.card__badge-label {
    font-size: 11px;
    color: rgb(255, 216, 64);
    -unity-font-style: bold;
}

.card__name {
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 18px;
}

.card__mech {
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 3px;
    margin-bottom: 12px;
    white-space: normal;
    padding-left: 8px;
    padding-right: 8px;
}

.card__body {
    font-size: 12px;
    color: rgba(228, 228, 232, 0.92);
    white-space: normal;
    padding-left: 15px;
    padding-right: 15px;
    flex-grow: 1;
}

.card__hint {
    font-size: 11px;
    color: rgba(222, 210, 150, 0.88);
    white-space: normal;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 10px;
}

.card__pick {
    margin-top: 14px;
    margin-left: 14px;
    margin-right: 14px;
    height: 38px;
    font-size: 15px;
    -unity-font-style: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.10);
    color: rgb(240, 240, 240);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.card__pick:hover {
    background-color: rgba(255, 255, 255, 0.22);
    scale: 1.03 1.03;
}

.footer {
    font-size: 12px;
    color: rgba(200, 200, 205, 0.5);
    margin-top: 20px;
    -unity-text-align: middle-center;
}
