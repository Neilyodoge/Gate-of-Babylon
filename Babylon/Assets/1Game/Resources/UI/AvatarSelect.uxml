<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="AvatarSelect.uss" />
    <ui:VisualElement name="overlay" class="overlay">
        <ui:VisualElement name="panel" class="panel">
            <ui:Label name="title" text="选 择 化 身" class="title" />
            <ui:Label name="subtitle" text="化身决定本局的「御灵方向」与被动规则——同一件灵物在不同化身下表现不同。" class="subtitle" />
            <ui:VisualElement name="cards" class="cards" />
            <ui:Label name="footer" text="[Esc] 默认选第一个 · 选完可在村庄回到司命使重选" class="footer" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
