/* 商店 · UITK (v0.6 uGUI→UITK) */

.shop-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.shop-panel {
    width: 900px;
    max-width: 96%;
    padding-top: 18px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgba(18, 14, 26, 0.97);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-width: 1px;
    border-color: rgba(210, 175, 90, 0.45);
    align-items: center;
}

.shop-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 224, 130);
    -unity-text-align: middle-center;
}

.shop-shards {
    font-size: 14px;
    color: rgb(130, 200, 255);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 14px;
}

.shop-cards {
    flex-direction: row;
    justify-content: center;
}

.shop-card {
    width: 158px;
    margin-left: 6px;
    margin-right: 6px;
    padding-bottom: 8px;
    background-color: rgba(30, 24, 42, 0.94);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    overflow: hidden;
    align-items: center;
    transition-property: translate, border-color;
    transition-duration: 0.1s;
}

.shop-card:hover {
    translate: 0 -5px;
    border-color: rgba(255, 216, 120, 0.6);
}

.shop-card--sold {
    opacity: 0.45;
}

.shop-rarity-bar {
    height: 5px;
    width: 100%;
    background-color: rgb(150, 150, 150);
}

.shop-icon {
    width: 70px;
    height: 50px;
    margin-top: 12px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.shop-icon-label {
    font-size: 26px;
    -unity-font-style: bold;
}

.shop-name {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 8px;
    white-space: normal;
}

.shop-rarity {
    font-size: 11px;
    color: rgba(180, 180, 185, 0.8);
    -unity-text-align: middle-center;
}

.shop-effect {
    font-size: 11px;
    color: rgba(150, 220, 150, 0.85);
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
    min-height: 46px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 4px;
}

.shop-price {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(140, 205, 255);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.shop-buy {
    height: 32px;
    width: 86%;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(50, 130, 75, 0.92);
    color: rgb(235, 245, 235);
}

.shop-buy:hover {
    background-color: rgba(60, 165, 90, 1);
}

.shop-buy--poor {
    background-color: rgba(90, 55, 55, 0.85);
    color: rgba(220, 180, 180, 0.85);
}

.shop-buy:disabled {
    opacity: 0.5;
}

.shop-tooltip {
    width: 100%;
    min-height: 56px;
    margin-top: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(10, 8, 16, 0.9);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 3px;
    border-left-color: rgba(210, 175, 90, 0.7);
    visibility: hidden;
}

.shop-tt-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 224, 130);
}

.shop-tt-body {
    font-size: 12px;
    color: rgba(220, 224, 232, 0.92);
    white-space: normal;
    margin-top: 3px;
}

.shop-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 10px;
}

.shop-hint {
    font-size: 11px;
    color: rgba(150, 140, 160, 0.6);
}

.shop-close {
    height: 34px;
    min-width: 130px;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(180, 130, 60, 0.4);
    color: rgb(245, 225, 180);
}

.shop-close:hover {
    background-color: rgba(210, 160, 70, 0.6);
}
