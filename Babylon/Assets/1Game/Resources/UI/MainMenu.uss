/* 主菜单 · UITK (v0.6) ——近不透明背景 */

.mm-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 10, 18);
}

.mm-center {
    align-items: center;
}

.mm-title {
    font-size: 62px;
    -unity-font-style: bold;
    color: rgb(255, 226, 150);
    -unity-text-align: middle-center;
    letter-spacing: 10px;
}

.mm-subtitle {
    font-size: 16px;
    color: rgba(190, 196, 210, 0.85);
    -unity-text-align: middle-center;
    margin-top: 6px;
    margin-bottom: 40px;
}

.mm-btns {
    width: 320px;
    align-items: stretch;
}

.mm-btn {
    height: 56px;
    margin-bottom: 14px;
    font-size: 20px;
    -unity-font-style: bold;
    border-width: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(235, 235, 240);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.mm-btn:hover {
    background-color: rgba(255, 216, 64, 0.20);
    color: rgb(255, 224, 130);
    scale: 1.02 1.02;
}

.mm-btn:disabled {
    opacity: 0.4;
}

.mm-btn--primary {
    background-color: rgba(255, 200, 70, 0.22);
    color: rgb(255, 224, 140);
}

.mm-btn--primary:hover {
    background-color: rgba(255, 200, 70, 0.38);
}

.mm-btn--warn:hover {
    background-color: rgba(235, 90, 90, 0.45);
    color: rgb(255, 220, 220);
}

.mm-saveinfo {
    position: absolute;
    bottom: 48px;
    left: 0;
    right: 0;
    font-size: 13px;
    color: rgba(170, 176, 190, 0.7);
    -unity-text-align: middle-center;
}

.mm-version {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    font-size: 12px;
    color: rgba(140, 146, 160, 0.6);
    -unity-text-align: middle-center;
}
